# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store

# testing
/coverage
.nyc_output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/
.swc/

# production
/build
/dist

# misc
*.pem
*.local

# debug & logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma / sqlite (local dev database)
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# user-uploaded media (keep folder via .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# editors & IDEs
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace
*.sublime-project
*.sublime-workspace

# turbo (if added later)
.turbo
